<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieApp</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark ma-navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand ma-navbar-brand" asp-controller="Home" asp-action="Index">MOVIEAPP</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav gap-1">

                        <!-- Catalog (standalone) -->
                        <li class="nav-item">
                            <a class="nav-link ma-nav-link" asp-controller="Catalog" asp-action="Index">Catalog</a>
                        </li>

                        <!-- Discover -->
                        <li class="nav-item dropdown">
                            <a class="nav-link ma-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Discover</a>
                            <ul class="dropdown-menu ma-dropdown">
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Marketplace" asp-action="Index">🏪 Marketplace</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="TrailerScraping" asp-action="Index">🎥 Trailer Scraping</a></li>
                            </ul>
                        </li>

                        <!-- Events -->
                        <li class="nav-item dropdown">
                            <a class="nav-link ma-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Events</a>
                            <ul class="dropdown-menu ma-dropdown">
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Events" asp-action="Index">🎭 Events</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Screenings" asp-action="Index">🎦 Screenings</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Screenings" asp-action="MyBookings">🎟 My Bookings</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Marathon" asp-action="Index">🏃 Marathon</a></li>
                            </ul>
                        </li>

                        <!-- Compete -->
                        <li class="nav-item dropdown">
                            <a class="nav-link ma-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Compete</a>
                            <ul class="dropdown-menu ma-dropdown">
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Tournament" asp-action="Index">🏆 Tournament</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Battle" asp-action="Index">⚔️ Battle &amp; Betting</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Trivia" asp-action="Index">🧠 Trivia</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="SlotMachine" asp-action="Index">🎰 Slot Machine</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Swipe" asp-action="Index">💫 Movie Swipe</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="PersonalityMatch" asp-action="Index">🎭 Personality Match</a></li>
                            </ul>
                        </li>

                        <!-- Reels -->
                        <li class="nav-item dropdown">
                            <a class="nav-link ma-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Reels</a>
                            <ul class="dropdown-menu ma-dropdown">
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="ReelsFeed" asp-action="Index">📽 Feed</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="ReelsUpload" asp-action="Index">⬆️ Upload</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="ReelsEditing" asp-action="Index">✂️ Editing</a></li>
                            </ul>
                        </li>

                        <!-- Account -->
                        <li class="nav-item dropdown">
                            <a class="nav-link ma-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Account</a>
                            <ul class="dropdown-menu ma-dropdown">
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Profile" asp-action="Index">👤 Profile</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Inventory" asp-action="Index">🎒 Inventory</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Wallet" asp-action="Index">💳 Wallet</a></li>
                                <li><hr class="dropdown-divider" style="border-color:#2a2a2a;"></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Referral" asp-action="Index">🔗 Referrals</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Ambassador" asp-action="Index">⭐ Ambassadors</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="PriceWatcher" asp-action="MyWatchers">👁 Price Watchers</a></li>
                                <li><a class="dropdown-item ma-dropdown-item" asp-controller="Marathon" asp-action="Index">🏆 Leaderboard</a></li>
                            </ul>
                        </li>

                    </ul>
                    <div class="navbar-nav ms-auto">
                        @await Component.InvokeAsync("NotificationBadge")
                    </div>
                </div>
                <div class="d-flex align-items-center ms-3 gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light small d-none d-xl-inline">@User.Identity.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-sm">Sign In</a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-light btn-sm">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2">
            &copy; 2026 - MovieApp
        </div>
    </footer>
	
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
	
</body>
</html>
