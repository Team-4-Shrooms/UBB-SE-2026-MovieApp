@model MovieApp.Web.ViewModels.Battles.BattleViewModel

@{
	ViewData["Title"] = "Movie Battle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="fw-bold m-0">Movie Battle</h2>
	<div class="text-muted fs-5">
		Points: <span class="fw-bold text-dark">@Model.CurrentUserPoints</span>
	</div>
</div>

@if (Model.StatusMessage != null)
{
		<div class="alert alert-info alert-dismissible fade show" role="alert">
		@Model.StatusMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
}

<div class="row g-4">
	<div class="col-lg-8">
		@if (Model.Battle == null)
		{
				<div class="card box-shadow border-0 py-5">
					<div class="card-body text-center text-warning">
						<i class="bi bi-exclamation-triangle fs-1"></i>
						<h5 class="mt-3 mb-0 fw-semibold">No active battle available at the moment.</h5>
						<p class="text-muted small">Use the Demo Actions panel to start a new simulation.</p>
					</div>
				</div>
		}
		else
		{
				<div class="card box-shadow border-0 mb-4">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center mb-4">
							<h5 class="fw-bold m-0 text-secondary">
								Battle #@Model.Battle.BattleId
							</h5>
							<span class="badge bg-dark px-3 py-2 rounded-pill">
							@Model.Battle.Status
							</span>
						</div>

						<div class="row g-3">
							<div class="col-md-6">
								<div class="card h-100 border border-light position-relative">
									<div class="card-body d-flex flex-column justify-content-between p-4">
										<div>
											<h4 class="fw-bold text-truncate mb-3">@Model.Battle.FirstMovie?.Title</h4>
											<div class="text-muted small mb-1">Total Bets</div>
											<div class="fs-5 fw-semibold mb-2">@Model.FirstMovieBetCount</div>
										</div>
										<div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
											<span class="fw-bold text-primary">@Model.FirstMoviePointTotal pts</span>
										@if (Model.WinnerMovieId == Model.Battle.FirstMovie?.Id)
										{
													<span class="badge bg-success">Winner</span>
										}
										</div>
									</div>
								</div>
							</div>

							<div class="col-md-6">
								<div class="card h-100 border border-light position-relative">
									<div class="card-body d-flex flex-column justify-content-between p-4">
										<div>
											<h4 class="fw-bold text-truncate mb-3">@Model.Battle.SecondMovie?.Title</h4>
											<div class="text-muted small mb-1">Total Bets</div>
											<div class="fs-5 fw-semibold mb-2">@Model.SecondMovieBetCount</div>
										</div>
										<div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
											<span class="fw-bold text-primary">@Model.SecondMoviePointTotal pts</span>
										@if (Model.WinnerMovieId == Model.Battle.SecondMovie?.Id)
										{
													<span class="badge bg-success">Winner</span>
										}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card box-shadow border-0">
					<div class="card-body p-4">
						<h5 class="fw-bold mb-3">Place Your Bet</h5>

						<form asp-action="PlaceBet" method="post" class="row g-3 align-items-end">
						@Html.AntiForgeryToken()
							<input type="hidden" name="BattleId" value="@Model.Battle.BattleId" />

							<div class="col-md-5">
								<label class="form-label fw-semibold small text-muted">Select Target Movie</label>
								<select name="MovieId" class="form-select py-2">
									<option value="@Model.Battle.FirstMovie?.Id">@Model.Battle.FirstMovie?.Title</option>
									<option value="@Model.Battle.SecondMovie?.Id">@Model.Battle.SecondMovie?.Title</option>
								</select>
							</div>

							<div class="col-md-4">
								<label class="form-label fw-semibold small text-muted">Betting Amount</label>
								<input type="number" name="Amount" min="1" class="form-control py-2" placeholder="Enter point value" required />
							</div>

							<div class="col-md-3">
								<button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Place Bet</button>
							</div>
						</form>
					</div>
				</div>
		}
	</div>

	<div class="col-lg-4">
		<div class="card box-shadow border-0 mb-4">
			<div class="card-body p-4">
				<h5 class="fw-bold mb-3">Leaderboard</h5>

				@if (!Model.LeaderboardRows.Any())
				{
						<div class="text-muted small py-3 text-center">No bets placed on this battle yet.</div>
				}
				else
				{
						<ul class="list-group list-group-flush max-height-scroll">
						@foreach (var row in Model.LeaderboardRows)
						{
									<li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
										<div class="text-truncate me-2">
											<div class="fw-semibold text-truncate">@row.Username</div>
											<small class="text-muted d-block text-truncate">@row.MovieTitle</small>
										</div>
										<span class="badge bg-light text-dark font-monospace fs-6 px-2">@row.Amount</span>
									</li>
						}
						</ul>
				}
			</div>
		</div>

		<div class="card box-shadow border-0 bg-light">
			<div class="card-body p-4">
				<h6 class="fw-bold text-uppercase tracking-wider text-muted small mb-3">Demo Controls</h6>

				<form asp-action="CreateDemo" method="post" class="mb-2">
					@Html.AntiForgeryToken()
					<button type="submit" class="btn btn-success w-100 fw-semibold">Initialize Demo Battle</button>
				</form>

				@if (Model.Battle != null)
				{
						<form asp-action="ForceSettle" method="post" class="mb-2">
						@Html.AntiForgeryToken()
							<input type="hidden" name="battleId" value="@Model.Battle.BattleId" />
							<button type="submit" class="btn btn-warning w-100 text-white fw-semibold">Force Settle Engine</button>
						</form>
				}

				<form asp-action="ResetDemo" method="post">
					@Html.AntiForgeryToken()
					<button type="submit" class="btn btn-outline-danger w-100 fw-semibold">Reset Environment</button>
				</form>
			</div>
		</div>
	</div>
</div>
