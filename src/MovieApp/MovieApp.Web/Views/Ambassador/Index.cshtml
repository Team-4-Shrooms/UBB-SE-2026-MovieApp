@model MovieApp.Web.Models.AmbassadorDashboardViewModel

@{
    ViewData["Title"] = "Ambassador";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold mb-0">Ambassador Program</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.IsAmbassador)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="mb-4">
                <i class="bi bi-star-fill text-warning" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-bold mb-2">Become an Ambassador</h3>
            <p class="text-muted mb-4">
                Share movies with friends, earn rewards, and get exclusive benefits by joining the Ambassador Program.
            </p>
            <form asp-action="Become" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                    <i class="bi bi-person-badge me-2"></i>Become an Ambassador
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted text-uppercase small fw-semibold mb-2">
                            <i class="bi bi-link-45deg me-1"></i>Your Referral Code
                        </h6>
                        <div class="d-flex align-items-center gap-3">
                            <span class="font-monospace fs-3 fw-bold text-primary" id="referralCode">@Model.ReferralCode</span>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="copyCode(event)" title="Copy code">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Share this code with friends to earn rewards.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted text-uppercase small fw-semibold mb-2">
                            <i class="bi bi-gift-fill me-1"></i>Reward Balance
                        </h6>
                        <p class="display-4 fw-bold text-success mb-0">@Model.RewardBalance</p>
                        <p class="text-muted small mt-2 mb-0">Points earned from successful referrals.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Referral History</h5>

                @if (!Model.History.Any())
                {
                    <div class="alert alert-info rounded-4 px-4 py-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>No referrals yet. Share your code to get started!
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Friend</th>
                                    <th>Event</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.History)
                                {
                                    <tr>
                                        <td><i class="bi bi-person me-2 text-muted"></i>@item.FriendName</td>
                                        <td><i class="bi bi-calendar-event me-2 text-muted"></i>@item.EventTitle</td>
                                        <td class="text-muted small">@item.FormattedDate</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <script>
        function copyCode(event) {
            const code = document.getElementById('referralCode').innerText;
            navigator.clipboard.writeText(code).then(() => {
                const btn = event.currentTarget;
                btn.innerHTML = '<i class="bi bi-check2"></i>';
                setTimeout(() => btn.innerHTML = '<i class="bi bi-clipboard"></i>', 2000);
            });
        }
    </script>
}
