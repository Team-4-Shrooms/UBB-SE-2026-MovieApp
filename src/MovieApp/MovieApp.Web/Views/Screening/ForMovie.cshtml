@model MovieApp.Web.Models.ScreeningListViewModel

@{
    ViewData["Title"] = Model.MovieTitle.Length > 0 ? $"{Model.MovieTitle} — Screenings" : "Screenings";
}

<div class="container mt-5">
    @if (!string.IsNullOrEmpty(Model.MoviePosterUrl))
    {
        <div class="row mb-5">
            <div class="col-md-3">
                <img src="@Model.MoviePosterUrl" class="img-fluid rounded-4 shadow-lg w-100"
                     style="object-fit: cover; max-height: 420px;"
                     alt="@Model.MovieTitle"
                     onerror="this.src='https://placehold.co/400x600?text=@Model.MovieTitle'">
            </div>
            <div class="col-md-9 d-flex align-items-center">
                <div>
                    <h1 class="mb-2" style="font-size:2.2rem; font-weight:800; color:#1c1917;">@Model.MovieTitle</h1>
                    <p class="text-muted fs-5">@Model.Screenings.Count screening(s) available</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title mb-0">@(Model.MovieTitle.Length > 0 ? Model.MovieTitle : "Screenings")</h1>
        </div>
    }

    @if (Model.Screenings.Count == 0)
    {
        <div class="alert alert-info rounded-4 px-4 py-3 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> No screenings scheduled for this movie.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var screening in Model.Screenings)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                    @screening.EventTitle
                                </span>
                                <span class="fw-bold text-success fs-6">€@screening.TicketPrice.ToString("0.00")</span>
                            </div>
                            <div class="mb-3">
                                <div class="text-muted small">Date &amp; Time</div>
                                <div class="fw-bold">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    @screening.ScreeningTime.ToString("dddd, dd MMM yyyy, HH:mm")
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="text-muted small">Location</div>
                                <div class="fw-bold">
                                    <i class="bi bi-geo-alt me-1"></i> @screening.EventLocation
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="text-muted small">Room</div>
                                <div class="fw-bold">
                                    <i class="bi bi-door-open me-1"></i> @screening.RoomName
                                    <span class="text-muted fw-normal ms-1 small">(@(screening.Rows * screening.Columns) seats)</span>
                                </div>
                            </div>
                            <a asp-controller="Screening" asp-action="Checkout" asp-route-id="@screening.ScreeningId"
                               class="btn btn-primary rounded-pill w-100 checkout-btn">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Choose Seats
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .checkout-btn {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none; font-weight: 600;
        transition: all 0.3s ease;
    }
    .checkout-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 117, 252, 0.3);
    }
    .rounded-4 { border-radius: 1rem !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
