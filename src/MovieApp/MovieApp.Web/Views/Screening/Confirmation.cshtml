@model MovieApp.WebDTOs.DTOs.ScreeningDetailsDto

@{
    ViewData["Title"] = "Booking Confirmed";
    var bookedCount = TempData["ConfirmedCount"] as int? ?? 0;
}

<div class="container mt-5">
    <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <div class="success-icon d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 96px; height: 96px; background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">
                    <i class="bi bi-check-lg text-white" style="font-size: 3rem;"></i>
                </div>
                <h1 class="display-5 fw-bold mb-2">Booking Confirmed!</h1>
                @if (bookedCount > 0)
                {
                    <p class="text-muted fs-5 mb-0">
                        You've successfully reserved
                        <span class="fw-bold text-primary">@bookedCount seat@(bookedCount != 1 ? "s" : "")</span>.
                    </p>
                }
                else
                {
                    <p class="text-muted fs-5 mb-0">Your seats have been reserved.</p>
                }
            </div>

            <hr class="my-4">

            <div class="row justify-content-center g-4 mb-4">
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(Model.MoviePosterUrl))
                    {
                        <img src="@Model.MoviePosterUrl" class="img-fluid rounded-4 shadow mb-3"
                             style="max-height: 280px; object-fit: cover;"
                             alt="@Model.MovieTitle"
                             onerror="this.src='https://placehold.co/400x600?text=@Model.MovieTitle'">
                    }
                    <h3 class="fw-bold mb-3">@Model.MovieTitle</h3>
                    <div class="d-flex flex-column gap-2 text-start">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-check text-primary fs-5"></i>
                            <div>
                                <div class="text-muted small">Date &amp; Time</div>
                                <div class="fw-bold">@Model.ScreeningTime.ToString("dddd, dd MMM yyyy, HH:mm")</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-primary fs-5"></i>
                            <div>
                                <div class="text-muted small">Location</div>
                                <div class="fw-bold">@Model.EventLocation</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-door-open text-primary fs-5"></i>
                            <div>
                                <div class="text-muted small">Room</div>
                                <div class="fw-bold">@Model.RoomName</div>
                            </div>
                        </div>
                        @if (bookedCount > 0)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-cash-coin text-success fs-5"></i>
                                <div>
                                    <div class="text-muted small">Total Paid</div>
                                    <div class="fw-bold text-success">
                                        @((Model.TicketPrice * bookedCount).ToString("0.00")) lei
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Screening" asp-action="ForMovie" asp-route-id="@Model.MovieId"
                   class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> More Screenings
                </a>
                <a asp-controller="Screenings" asp-action="MyBookings"
                   class="btn btn-primary rounded-pill px-4 checkout-btn">
                    <i class="bi bi-ticket-perforated-fill me-1"></i> My Bookings
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .checkout-btn {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none;
    }
    .rounded-5 { border-radius: 2rem !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
