@model MovieApp.Web.Models.CheckoutViewModel

@{
    var s = Model.Screening;
    ViewData["Title"] = $"{s.MovieTitle} — Checkout";
}

<div class="container mt-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 px-4 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-5 overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(s.MoviePosterUrl))
                {
                    <img src="@s.MoviePosterUrl" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 300px;"
                         alt="@s.MovieTitle"
                         onerror="this.src='https://placehold.co/600x900?text=@s.MovieTitle'">
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light h-100" style="min-height: 300px;">
                        <i class="bi bi-film display-1 text-muted"></i>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">@s.EventTitle</span>
                        <h4 class="mb-0 fw-bold" style="color:#b5800e;">
                            @s.TicketPrice.ToString("0.00") lei
                            <small class="fw-normal" style="color:#8a8480;">/ seat</small>
                        </h4>
                    </div>
                    <h1 class="mb-3" style="font-size:1.8rem; font-weight:800; color:#1c1917;">@s.MovieTitle</h1>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <div class="text-muted small">Date &amp; Time</div>
                            <div class="fw-bold">
                                <i class="bi bi-calendar-check me-1"></i>
                                @s.ScreeningTime.ToString("dddd, dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Location</div>
                            <div class="fw-bold"><i class="bi bi-geo-alt me-1"></i> @s.EventLocation</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Room</div>
                            <div class="fw-bold"><i class="bi bi-door-open me-1"></i> @s.RoomName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Capacity</div>
                            <div class="fw-bold">
                                <i class="bi bi-people me-1"></i>
                                @(s.Rows * s.Columns) seats (@s.Rows × @s.Columns)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-5 p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Choose Your Seats</h2>
            <a asp-controller="Screening" asp-action="ForMovie" asp-route-id="@s.MovieId"
               class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="screen-banner mb-4">
            <div class="screen-line"></div>
            <p class="text-center text-muted small mt-2 mb-0">SCREEN</p>
        </div>

        <form asp-controller="Screening" asp-action="Reserve" method="post" id="reserveForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="screeningId" value="@s.ScreeningId" />
            <input type="hidden" name="selectedSeats" id="selectedSeatsField" value="" />

            <div class="seat-grid mx-auto mb-4">
                @for (int row = 1; row <= s.Rows; row++)
                {
                    <div class="seat-row d-flex justify-content-center align-items-center mb-2">
                        <span class="row-label text-muted me-3 fw-bold">@row</span>
                        @for (int col = 1; col <= s.Columns; col++)
                        {
                            var seat = Model.Seats.FirstOrDefault(sv => sv.Row == row && sv.Col == col);
                            if (seat == null) { continue; }

                            var cssClass = seat.IsAvailable ? "seat" : "seat seat-taken";

                            <button type="button"
                                    class="@cssClass"
                                    data-row="@seat.Row"
                                    data-col="@seat.Col"
                                    data-available="@seat.IsAvailable.ToString().ToLowerInvariant()"
                                    title="Row @seat.Row, Seat @seat.Col"
                                    @(!seat.IsAvailable ? "disabled" : "")>
                                @seat.Col
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="legend d-flex justify-content-center gap-4 mb-4 small">
                <div><span class="legend-box legend-available"></span> Available</div>
                <div><span class="legend-box legend-selected"></span> Selected</div>
                <div><span class="legend-box legend-taken"></span> Taken</div>
            </div>

            <div class="d-flex justify-content-between align-items-center bg-light rounded-4 p-3 mb-4">
                <div>
                    <div class="text-muted small">Selected seats</div>
                    <div class="fw-bold fs-5" id="selectedSeatsLabel">None</div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Total</div>
                    <div class="fw-bold fs-5">
                        <span id="selectedCount">0</span> ×
                        @s.TicketPrice.ToString("0.00") lei =
                        <span id="selectedTotal" class="text-success">0.00 lei</span>
                    </div>
                </div>
            </div>

            <button type="submit" id="confirmButton"
                    class="btn btn-primary btn-lg w-100 rounded-pill py-3 shadow-lg purchase-btn" disabled>
                <i class="bi bi-ticket-detailed-fill me-2"></i> Confirm &amp; Reserve
            </button>
        </form>
    </div>
</div>

<style>
    .screen-banner { max-width: 600px; margin: 0 auto; }
    .screen-line {
        height: 6px;
        background: linear-gradient(90deg, transparent, #6a11cb, #2575fc, transparent);
        border-radius: 3px;
        box-shadow: 0 0 20px rgba(106, 17, 203, 0.4);
    }
    .seat-grid { max-width: 700px; }
    .row-label { width: 24px; text-align: center; }
    .seat {
        width: 38px; height: 38px; margin: 0 4px;
        border-radius: 8px 8px 4px 4px;
        border: 1px solid #d6d6d6;
        background: #ffffff;
        font-size: 11px; color: #888;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .seat:hover:not(.seat-taken):not(.seat-selected) {
        background: #e3f2fd; border-color: #2575fc;
        transform: translateY(-2px);
    }
    .seat-selected {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border-color: #2575fc; color: #ffffff; font-weight: bold;
    }
    .seat-taken {
        background: #f5f5f5; color: #ccc;
        cursor: not-allowed; text-decoration: line-through;
    }
    .legend-box {
        display: inline-block; width: 14px; height: 14px;
        border-radius: 4px; vertical-align: middle;
        margin-right: 6px; border: 1px solid #d6d6d6;
    }
    .legend-available { background: #ffffff; }
    .legend-selected { background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); border-color: #2575fc; }
    .legend-taken { background: #f5f5f5; }
    .purchase-btn {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none; font-weight: 700; letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }
    .purchase-btn:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(37, 117, 252, 0.3) !important;
    }
    .purchase-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .rounded-5 { border-radius: 2rem !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<script>
    (function () {
        const selected = new Map();
        const field = document.getElementById('selectedSeatsField');
        const label = document.getElementById('selectedSeatsLabel');
        const count = document.getElementById('selectedCount');
        const total = document.getElementById('selectedTotal');
        const confirm = document.getElementById('confirmButton');
        const unitPrice = @s.TicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

        document.querySelectorAll('.seat').forEach(btn => {
            if (btn.dataset.available !== 'true') return;
            btn.addEventListener('click', () => {
                const key = btn.dataset.row + '-' + btn.dataset.col;
                if (selected.has(key)) {
                    selected.delete(key);
                    btn.classList.remove('seat-selected');
                } else {
                    selected.set(key, true);
                    btn.classList.add('seat-selected');
                }
                update();
            });
        });

        function update() {
            const keys = Array.from(selected.keys());
            field.value = keys.join(',');
            count.textContent = keys.length.toString();
            label.textContent = keys.length === 0
                ? 'None'
                : keys.map(k => { const p = k.split('-'); return 'R' + p[0] + 'C' + p[1]; }).join(', ');
            total.textContent = (keys.length * unitPrice).toFixed(2) + ' lei';
            confirm.disabled = keys.length === 0;
        }
    })();
</script>
