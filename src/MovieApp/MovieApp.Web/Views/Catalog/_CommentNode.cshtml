@model MovieApp.DataLayer.Models.Comment

@{
    // Margin scales with depth (or use a fixed left margin for all replies)
    // We can pass depth via ViewData or just use a fixed margin for replies.
    var depth = (int)(ViewData["depth"] ?? 0);
    var marginClass = depth > 0 ? "ms-4" : "";
}

<div class="list-group-item p-3 mt-2 box-shadow rounded @marginClass">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold mb-0">@(Model.Author?.Username ?? "AnonymousUser")</h6>
        <small class="text-muted">@Model.CreatedAt.ToString("g")</small>
    </div>
    <p class="mb-2 text-break" style="white-space: pre-line;">@Model.Content</p>
    
    <div class="mt-2">
        <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#replyForm-@Model.CommentId">
            Reply
        </button>
        <div class="collapse mt-2" id="replyForm-@Model.CommentId">
            <form asp-action="AddReply" method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MovieId" value="@Model.MovieId" />
                <input type="hidden" name="ParentCommentId" value="@Model.CommentId" />
                <textarea name="Content" class="form-control form-control-sm" rows="2" placeholder="Write a reply..." required></textarea>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm" type="submit">Post Reply</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Replies != null && Model.Replies.Any())
    {
        <div class="mt-3 border-start border-2 ps-2">
            @foreach (var reply in Model.Replies)
            {
                var childViewData = new ViewDataDictionary(ViewData);
                childViewData["depth"] = depth + 1;
                <partial name="_CommentNode" model="reply" view-data="childViewData" />
            }
        </div>
    }
</div>
