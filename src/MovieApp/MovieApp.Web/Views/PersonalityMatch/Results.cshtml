@model MovieApp.Web.Models.PersonalityMatchResultsViewModel
@{
    ViewData["Title"] = "Your Matches";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="page-title">Your Matches</h1>
        <p class="lead">These users share your taste in movies.</p>
    </div>

    @if (Model.Matches.Count == 0)
    {
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <p class="text-muted fs-5 mb-4">No matches found yet. Try swiping more movies to build your profile!</p>
            <a asp-controller="Swipe" asp-action="Index" class="btn btn-primary btn-lg px-5">Go to Movie Swipe</a>
        </div>
    </div>
    }
    else
    {
    <div class="row g-4 justify-content-center">
        @foreach (var match in Model.Matches)
            {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100" style="border:1.5px solid #e8e3db;">
                <div class="card-body text-center" style="background:#f9f7f4;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:64px; height:64px; background:#1c1917; color:#c9a55a; font-size:1.6rem; font-weight:800; border:3px solid #c9a55a;">
                        @(match.Username.Length > 0 ? match.Username[0].ToString().ToUpper() : "?")
                    </div>
                    <h5 class="card-title" style="font-weight:700;">@match.Username</h5>
                    <p style="color:#b5800e; font-weight:700;">@($"{match.MatchScore:P0}") match</p>
                </div>
            </div>
        </div>
            }
    </div>

    <div class="text-center mt-5">
        <form asp-action="Index" method="get" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-lg px-5">Retake Quiz</button>
        </form>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-lg px-5 ms-3">Browse Movie Catalog</a>
    </div>
    }
</div>
