@model IEnumerable<MovieApp.DataLayer.Models.Equipment>

@{
    ViewData["Title"] = "Marketplace";
}

<div class="marketplace-container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <h1 class="page-title mb-0">Marketplace</h1>
        <div class="d-flex gap-2">
            <input type="text" id="searchInput" class="form-control" placeholder="Search equipment..." style="width:220px;" />
            <a asp-action="Sell" class="btn btn-primary">Sell Equipment</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="equipmentList">
        @foreach (var item in Model)
        {
            <div class="col equipment-card-wrapper" data-name="@item.Title">
                <div class="card h-100 border-0 shadow-lg premium-card">
                    <div class="card-img-container">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" onerror="this.src='https://placehold.co/600x400?text=@item.Title'">
                        <div class="card-badge">@item.Category</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted text-truncate">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="mp-price">@item.Price.ToString("C")</span>
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-secondary">Details</a>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <form asp-action="Buy" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-primary w-100">Buy Now</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log("Marketplace Search Initialized (Robust jQuery)");
            
            var $searchInput = $("#searchInput");
            var $cards = $(".equipment-card-wrapper");
            
            $searchInput.on("input keyup", function() {
                var query = $(this).val().toLowerCase().trim();
                console.log("Query: " + query);
                
                $cards.each(function() {
                    var $card = $(this);
                    var title = $card.attr("data-name") || "";
                    var isMatch = title.toLowerCase().indexOf(query) > -1;
                    
                    if (isMatch) {
                        $card.show();
                    } else {
                        $card.hide();
                    }
                });
            });
        });
    </script>
}

<style>
    .premium-card {
        border: 1.5px solid #e8e3db;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .premium-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 36px rgba(0,0,0,.1) !important;
        border-color: #c9a55a;
    }
    .card-img-container { position: relative; height: 200px; overflow: hidden; }
    .card-img-top { width:100%; height:100%; object-fit:cover; transition: transform 0.3s ease; }
    .premium-card:hover .card-img-top { transform: scale(1.05); }
    .card-badge {
        position: absolute; top: 10px; right: 10px;
        background: rgba(0,0,0,.65); color: #c9a55a;
        padding: 3px 12px; border-radius: 20px;
        font-size: .7rem; font-weight: 700; letter-spacing: .08em;
        backdrop-filter: blur(6px);
    }
    .mp-price { font-size:1.2rem; font-weight:800; color:#1c1917; }
</style>
