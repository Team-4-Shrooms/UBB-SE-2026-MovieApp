@model System.Collections.Generic.List<MovieApp.DataLayer.Models.PriceWatcher>

@{
    ViewData["Title"] = "Price Watchers";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold mb-0">Price Watchers</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-bell-fill me-2"></i>Watched Events</h5>

            @if (!Model.Any())
            {
                <div class="alert alert-info rounded-4 px-4 py-3 mb-0">
                    <i class="bi bi-info-circle me-2"></i>No events are being watched. Go to an event detail page to add a watcher.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Event</th>
                                <th>Target Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var watcher in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@watcher.EventTitle</div>
                                        <div class="text-muted small">Event #@watcher.EventId</div>
                                    </td>
                                    <td class="fw-bold text-success">@watcher.TargetPrice.ToString("C")</td>
                                    <td class="text-end">
                                        <form asp-controller="PriceWatcher" asp-action="Unwatch" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="watchId" value="@watcher.EventId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                <i class="bi bi-bell-slash me-1"></i>Unwatch
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
