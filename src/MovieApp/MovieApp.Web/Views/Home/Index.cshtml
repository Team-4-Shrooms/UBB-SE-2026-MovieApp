@{
    ViewData["Title"] = "MovieIT";
}

@section Styles {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
    :root {
        --ink:     #1c1917;
        --ink-50:  #8a8480;
        --ink-20:  #d6d2cc;
        --amber:   #b5800e;
        --amber-bg: rgba(181, 128, 14, .08);
        --surface: #f9f7f4;
        --white:   #ffffff;
        --border:  #e8e3db;
        --ff-d: 'Playfair Display', Georgia, serif;
        --ff-b: 'DM Sans', system-ui, sans-serif;
    }

    body { background: var(--white) !important; }

    .hp {
        margin-left:  calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        width: 100vw;
        overflow-x: hidden;
        font-family: var(--ff-b);
        color: var(--ink);
    }

    /* ── HERO ── */
    .hp-hero {
        background: var(--white);
        text-align: center;
        padding: 6rem 2rem 5rem;
        border-bottom: 1px solid var(--border);
    }

    .hp-eyebrow {
        display: inline-block;
        font-size: .7rem;
        font-weight: 500;
        letter-spacing: .35em;
        text-transform: uppercase;
        color: var(--amber);
        margin-bottom: 1.5rem;
        opacity: 0;
        animation: fadeUp .6s ease forwards .1s;
    }

    .hp-title {
        font-family: var(--ff-d);
        font-size: clamp(3rem, 8vw, 7rem);
        font-weight: 400;
        line-height: 1.05;
        color: var(--ink);
        margin: 0 auto 1.5rem;
        max-width: 820px;
        opacity: 0;
        animation: fadeUp .7s ease forwards .25s;
    }

    .hp-title em {
        font-style: italic;
        color: var(--amber);
    }

    .hp-sub {
        font-size: 1rem;
        font-weight: 300;
        color: var(--ink-50);
        max-width: 420px;
        margin: 0 auto 2.5rem;
        line-height: 1.7;
        opacity: 0;
        animation: fadeUp .6s ease forwards .4s;
    }

    .hp-ctas {
        display: flex;
        justify-content: center;
        gap: .75rem;
        flex-wrap: wrap;
        opacity: 0;
        animation: fadeUp .6s ease forwards .55s;
    }

    .hp-btn {
        display: inline-block;
        padding: .7rem 1.8rem;
        font-family: var(--ff-b);
        font-size: .82rem;
        font-weight: 500;
        letter-spacing: .06em;
        text-decoration: none;
        border-radius: 4px;
        transition: all .22s ease;
    }
    .hp-btn-dark {
        background: var(--ink);
        color: var(--white);
    }
    .hp-btn-dark:hover {
        background: #2d2926;
        color: var(--white);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(28,25,23,.18);
    }
    .hp-btn-outline {
        border: 1.5px solid var(--border);
        color: var(--ink-50);
    }
    .hp-btn-outline:hover {
        border-color: var(--ink);
        color: var(--ink);
        transform: translateY(-2px);
    }

    /* ── FEATURES ── */
    .hp-features {
        padding: 4rem 7vw 3rem;
        background: var(--surface);
    }

    .hp-section-title {
        font-size: .65rem;
        font-weight: 500;
        letter-spacing: .4em;
        text-transform: uppercase;
        color: var(--ink-50);
        margin-bottom: 1.6rem;
    }

    .hp-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr;
        grid-template-rows: 210px 190px;
        gap: 10px;
    }

    .hp-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        text-decoration: none;
        color: var(--ink);
        transition: box-shadow .22s ease, transform .22s ease;
        position: relative;
        overflow: hidden;
    }
    .hp-card:hover {
        box-shadow: 0 8px 28px rgba(28,25,23,.1);
        transform: translateY(-3px);
        color: var(--ink);
    }

    .hp-card-span { grid-row: span 2; justify-content: flex-end; }

    .hp-card-icon {
        font-size: 1.8rem;
        position: absolute;
        top: 1.4rem;
        left: 1.5rem;
    }

    .hp-card-tag {
        display: inline-block;
        font-size: .62rem;
        font-weight: 500;
        letter-spacing: .1em;
        text-transform: uppercase;
        padding: .25rem .6rem;
        border-radius: 3px;
        margin-bottom: .6rem;
        width: fit-content;
    }

    .hp-card h3 {
        font-family: var(--ff-d);
        font-size: 1.3rem;
        font-weight: 400;
        margin: 0 0 .3rem;
    }
    .hp-card p {
        font-size: .8rem;
        font-weight: 300;
        color: var(--ink-50);
        margin: 0;
        line-height: 1.55;
    }

    /* card accent colors */
    .hp-card--catalog  { border-top: 3px solid #b5800e; }
    .hp-card--market   { border-top: 3px solid #2e7d8f; }
    .hp-card--slots    { border-top: 3px solid #7c3aed; }
    .hp-card--battle   { border-top: 3px solid #c13333; }
    .hp-card--reels    { border-top: 3px solid #2d7a52; }

    .tag-amber  { background: rgba(181,128,14,.1);  color: #92660a; }
    .tag-teal   { background: rgba(46,125,143,.1);  color: #226070; }
    .tag-violet { background: rgba(124,58,237,.1);  color: #5b21b6; }
    .tag-red    { background: rgba(193,51,51,.1);   color: #9b2626; }
    .tag-green  { background: rgba(45,122,82,.1);   color: #1a5e3a; }

    /* ── SECONDARY ── */
    .hp-secondary {
        padding: 0 7vw 5rem;
        background: var(--surface);
    }

    .hp-pills {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .hp-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1.05rem;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 100px;
        color: var(--ink-50);
        text-decoration: none;
        font-size: .78rem;
        font-weight: 400;
        transition: all .18s ease;
    }
    .hp-pill:hover {
        border-color: var(--ink);
        color: var(--ink);
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(28,25,23,.08);
    }

    /* ── ANIMATIONS ── */
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .sr { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
    .sr.in { opacity: 1; transform: none; }
    .sr-d1 { transition-delay: .08s; }
    .sr-d2 { transition-delay: .16s; }
    .sr-d3 { transition-delay: .24s; }
    .sr-d4 { transition-delay: .32s; }
    .sr-d5 { transition-delay: .40s; }

    @@media (max-width: 768px) {
        .hp-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
        .hp-card-span { grid-row: span 1; }
    }
    @@media (max-width: 480px) {
        .hp-grid { grid-template-columns: 1fr; }
    }
</style>
}

<div class="hp">

    <!-- HERO -->
    <section class="hp-hero">
        <span class="hp-eyebrow">Your cinematic universe</span>
        <h1 class="hp-title">Discover, collect &amp; experience <em>film</em></h1>
        <p class="hp-sub">Browse movies, join events, compete in tournaments, and share your passion for cinema.</p>
        <div class="hp-ctas">
            <a asp-controller="Catalog" asp-action="Index" class="hp-btn hp-btn-dark">Browse Catalog</a>
            <a asp-controller="Marketplace" asp-action="Index" class="hp-btn hp-btn-outline">Marketplace</a>
        </div>
    </section>

    <!-- MAIN FEATURES -->
    <section class="hp-features">
        <p class="hp-section-title sr">Featured</p>
        <div class="hp-grid">

            <!-- Catalog -->
            <a asp-controller="Catalog" asp-action="Index" class="hp-card hp-card--catalog hp-card-span sr sr-d1">
                <div class="hp-card-icon">🎬</div>
                <span class="hp-card-tag tag-amber">Catalog</span>
                <h3>Movie Catalog</h3>
                <p>Browse the full library. Filter by genre, price, or rating.</p>
            </a>

            <!-- Marketplace -->
            <a asp-controller="Marketplace" asp-action="Index" class="hp-card hp-card--market sr sr-d2">
                <div class="hp-card-icon">🏪</div>
                <span class="hp-card-tag tag-teal">Shop</span>
                <h3>Marketplace</h3>
                <p>Trade and discover titles.</p>
            </a>

            <!-- Slot Machine -->
            <a asp-controller="SlotMachine" asp-action="Index" class="hp-card hp-card--slots sr sr-d3">
                <div class="hp-card-icon">🎰</div>
                <span class="hp-card-tag tag-violet">Games</span>
                <h3>Slot Machine</h3>
                <p>Spin to win discounts.</p>
            </a>

            <!-- Battle -->
            <a asp-controller="Battle" asp-action="Index" class="hp-card hp-card--battle sr sr-d4">
                <div class="hp-card-icon">⚔️</div>
                <span class="hp-card-tag tag-red">Compete</span>
                <h3>Battle &amp; Betting</h3>
                <p>Wager points on matchups.</p>
            </a>

            <!-- Reels -->
            <a asp-controller="ReelsFeed" asp-action="Index" class="hp-card hp-card--reels sr sr-d5">
                <div class="hp-card-icon">📽️</div>
                <span class="hp-card-tag tag-green">Social</span>
                <h3>Reels</h3>
                <p>Watch and share clips.</p>
            </a>

        </div>
    </section>

    <!-- MORE FEATURES -->
    <section class="hp-secondary">
        <p class="hp-section-title sr">More to explore</p>
        <div class="hp-pills sr sr-d1">
            <a asp-controller="Tournament" asp-action="Index" class="hp-pill">🏆 Tournament</a>
            <a asp-controller="Trivia" asp-action="Index" class="hp-pill">🧠 Trivia</a>
            <a asp-controller="Events" asp-action="Index" class="hp-pill">🎭 Events</a>
            <a asp-controller="Screenings" asp-action="Index" asp-route-eventId="1" class="hp-pill">🎦 Screenings</a>
            <a asp-controller="Marathon" asp-action="Index" class="hp-pill">🏃 Marathon</a>
            <a asp-controller="Swipe" asp-action="Index" class="hp-pill">💫 Movie Swipe</a>
            <a asp-controller="PersonalityMatch" asp-action="Index" class="hp-pill">🎭 Personality Match</a>
            <a asp-controller="TrailerScraping" asp-action="Index" class="hp-pill">🎥 Trailer Scraping</a>
            <a asp-controller="Ambassador" asp-action="Index" class="hp-pill">⭐ Ambassadors</a>
            <a asp-controller="Referral" asp-action="Index" class="hp-pill">🔗 Referrals</a>
            <a asp-controller="Wallet" asp-action="Index" class="hp-pill">💳 Wallet</a>
            <a asp-controller="Inventory" asp-action="Index" class="hp-pill">🎒 Inventory</a>
            <a asp-controller="Profile" asp-action="Index" class="hp-pill">👤 Profile</a>
            <a asp-controller="PriceWatcher" asp-action="MyWatchers" class="hp-pill">👁 Price Watchers</a>
        </div>
    </section>

</div>

@section Scripts {
<script>
(function () {
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { threshold: 0.08 });
    document.querySelectorAll('.sr').forEach(el => io.observe(el));
})();
</script>
}
