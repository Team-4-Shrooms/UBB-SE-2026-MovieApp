@model IReadOnlyList<MovieApp.WebDTOs.DTOs.ScreeningDetailsDto>

@{
    ViewData["Title"] = "Screenings";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold mb-0">Upcoming Screenings</h1>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> New Screening
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info rounded-4 px-4 py-3 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> No screenings scheduled.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var screening in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        @if (!string.IsNullOrEmpty(screening.MoviePosterUrl))
                        {
                            <img src="@screening.MoviePosterUrl" class="card-img-top" style="height: 320px; object-fit: cover;"
                                 alt="@screening.MovieTitle"
                                 onerror="this.src='https://placehold.co/600x400?text=@screening.MovieTitle'">
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">@screening.EventTitle</span>
                                <span class="fw-bold text-success">@screening.TicketPrice.ToString("C")</span>
                            </div>
                            <h5 class="card-title fw-bold mb-1">@screening.MovieTitle</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-clock me-1"></i> @screening.ScreeningTime.ToString("dddd, dd MMM yyyy, HH:mm")<br />
                                <i class="bi bi-geo-alt me-1"></i> @screening.EventLocation &middot; @screening.RoomName
                            </p>
                            <a asp-action="Detail" asp-route-id="@screening.ScreeningId" class="btn btn-primary rounded-pill w-100">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Choose Seats
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
