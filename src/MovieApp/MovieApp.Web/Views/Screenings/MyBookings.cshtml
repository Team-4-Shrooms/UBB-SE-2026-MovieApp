@model IReadOnlyList<MovieApp.Web.Models.MyBookingGroupViewModel>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">My Bookings</h1>
        <a asp-action="Index" asp-route-eventId="1" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Screenings
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 px-4 py-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info rounded-4 px-4 py-3 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> You haven't booked any seats yet.
            <a asp-action="Index" asp-route-eventId="1" class="alert-link ms-2">Browse screenings</a>.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var group in Model)
            {
                var totalLei = group.Bookings.Count * group.Details.TicketPrice;
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="row g-0">
                        @if (!string.IsNullOrEmpty(group.Details.MoviePosterUrl))
                        {
                            <div class="col-md-3">
                                <img src="@group.Details.MoviePosterUrl" class="img-fluid h-100 w-100"
                                     style="object-fit: cover; min-height: 220px;"
                                     alt="@group.Details.MovieTitle"
                                     onerror="this.src='https://placehold.co/400x600?text=@group.Details.MovieTitle'">
                            </div>
                        }
                        <div class="col-md-9">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">
                                            @group.Details.EventTitle
                                        </span>
                                        <h4 class="fw-bold mb-1">@group.Details.MovieTitle</h4>
                                    </div>
                                    <span class="fw-bold text-success fs-5">€@totalLei.ToString("0.00")</span>
                                </div>

                                <p class="text-muted small mb-3">
                                    <i class="bi bi-clock me-1"></i> @group.Details.ScreeningTime.ToString("dddd, dd MMM yyyy, HH:mm")<br />
                                    <i class="bi bi-geo-alt me-1"></i> @group.Details.EventLocation &middot; @group.Details.RoomName
                                </p>

                                <div class="mb-3">
                                    <span class="text-muted small me-2">Your seats (@group.Bookings.Count):</span>
                                    @foreach (var booking in group.Bookings)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 me-1 mb-1">
                                            <i class="bi bi-ticket-perforated-fill me-1"></i>
                                            Row @booking.Row, Seat @booking.Column
                                        </span>
                                    }
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Detail" asp-route-id="@group.Details.ScreeningId"
                                       class="btn btn-outline-primary btn-sm rounded-pill">
                                        <i class="bi bi-grid-3x3-gap me-1"></i> View Seat Map
                                    </a>
                                    @foreach (var booking in group.Bookings)
                                    {
                                        <form asp-action="CancelBooking" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill"
                                                    onclick="return confirm('Cancel seat R@(booking.Row)C@(booking.Column)?');">
                                                <i class="bi bi-x-circle me-1"></i> Cancel R@(booking.Row)C@(booking.Column)
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
