<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Screenings.Views.MyBookingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieApp.Features.Screenings.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back + title -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Click="BackButton_Click"
                    Background="Transparent"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1"
                       Text="My Bookings"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Loading -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,12"/>

        <!-- Status message -->
        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontStyle="Italic"
                   FontSize="14"
                   Margin="0,0,0,12"/>

        <!-- Booking groups -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.BookingGroups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookingGroupViewModel">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,16"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Poster -->
                                <Border Height="140" CornerRadius="8"
                                        Background="{StaticResource CardBorderBrush}">
                                    <Image Source="{x:Bind Screening.MoviePosterUrl}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Screening.MovieTitle}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Screening.EventTitle}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind TimeDisplay}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Screening.EventLocation}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <!-- Booked seats as badges -->
                                    <ItemsControl ItemsSource="{x:Bind Seats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BookingItemViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="{StaticResource GoldBrush}"
                                                            CornerRadius="4" Padding="8,4">
                                                        <TextBlock Text="{x:Bind Label}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#000000"/>
                                                    </Border>
                                                    <Button Content="Cancel"
                                                            Tag="{x:Bind BookingId}"
                                                            Click="CancelBooking_Click"
                                                            Background="Transparent"
                                                            Foreground="#CC5555"
                                                            Padding="6,2"
                                                            FontSize="11"
                                                            CornerRadius="4"
                                                            BorderBrush="#CC5555"
                                                            BorderThickness="1"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Total -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Total paid:"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind TotalDisplay}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource GoldBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
