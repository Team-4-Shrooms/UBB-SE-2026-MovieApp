<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Screenings.Views.ScreeningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieApp.Features.Screenings.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left Pane: Screening List ===== -->
        <Grid Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Screenings"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="My Bookings"
                        Click="MyBookings_Click"
                        Background="{StaticResource CardBorderBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        CornerRadius="6" Padding="10,6"/>
            </Grid>

            <!-- Loading indicator -->
            <ProgressRing Grid.Row="1"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="24" Height="24"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Center"/>

            <!-- Screening cards -->
            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Screenings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScreeningCardViewModel">
                        <Border Background="{StaticResource CardHoverBrush}" CornerRadius="8" Padding="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Poster thumbnail -->
                                <Border Height="80" CornerRadius="4"
                                        Background="{StaticResource CardBorderBrush}">
                                    <Image Source="{x:Bind MoviePosterUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind MovieTitle}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind EventTitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind TimeDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind EventLocation}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind PriceDisplay}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== Right Pane ===== -->
        <Grid Grid.Column="1" Padding="24">

            <!-- Empty state -->
            <TextBlock Text="Select a screening to view the seat map"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="16" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"/>

            <!-- Detail panel -->
            <Grid Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Info card: poster + metadata -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="170" CornerRadius="8"
                                Background="{StaticResource CardBorderBrush}">
                            <Image Source="{x:Bind ViewModel.SelectedScreening.MoviePosterUrl, Mode=OneWay}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.MovieTitle, Mode=OneWay}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.EventTitle, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.TimeDisplay, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.EventLocation, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.RoomName, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedCard.PriceDisplay, Mode=OneWay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}"/>
                                <TextBlock Text="/ seat"
                                           FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Screen label -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardBorderBrush}"
                        CornerRadius="4" Padding="8,4" Margin="0,0,0,16"
                        HorizontalAlignment="Stretch">
                    <TextBlock Text="— SCREEN —"
                               HorizontalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <!-- Seat grid (rows of seats) -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SeatRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeatRowViewModel">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <!-- Row number label -->
                                    <TextBlock Text="{x:Bind RowNumber}"
                                               Width="22"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,0"/>
                                    <!-- Seats in this row -->
                                    <ItemsControl ItemsSource="{x:Bind Seats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SeatStatusViewModel">
                                                <Button Width="38" Height="38" Margin="3"
                                                        Padding="0"
                                                        CornerRadius="4"
                                                        Background="{x:Bind SeatBackground, Mode=OneWay}"
                                                        Command="{x:Bind ToggleCommand}"
                                                        ToolTipService.ToolTip="{x:Bind DisplayLabel}">
                                                    <TextBlock Text="{x:Bind Column}"
                                                               FontSize="11"
                                                               Foreground="{x:Bind SeatForeground, Mode=OneWay}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Legend + selection summary + Book button -->
                <StackPanel Grid.Row="3" Spacing="12">

                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="16" CornerRadius="3" Background="#252320"/>
                            <TextBlock Text="Available" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="16" CornerRadius="3"
                                    Background="{StaticResource GoldBrush}"/>
                            <TextBlock Text="Selected" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="16" CornerRadius="3" Background="#403C38"/>
                            <TextBlock Text="Taken" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status message -->
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="13"
                               Visibility="{x:Bind ViewModel.StatusMessageVisibility, Mode=OneWay}"/>

                    <!-- Selected seats + total + book -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeatsSummary, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Total:"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TotalCostDisplay, Mode=OneWay}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Book Seats"
                                Command="{x:Bind ViewModel.BookSeatsCommand}"
                                Background="{StaticResource GoldBrush}"
                                Foreground="#000000"
                                CornerRadius="8" Padding="20,10"
                                FontSize="15" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
