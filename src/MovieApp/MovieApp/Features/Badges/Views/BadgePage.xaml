<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Badges.Views.BadgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieApp.Features.Badges.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960">

            <!-- Avatar + username header -->
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="3">
                    <TextBlock Text="{x:Bind ViewModel.AvatarLetter, Mode=OneWay}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Username, Mode=OneWay}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Member profile"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 4 stat cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Stats.TotalPoints, Mode=OneWay, FallbackValue='0'}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="TOTAL POINTS"
                                   FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Stats.WeeklyScore, Mode=OneWay, FallbackValue='0'}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="WEEKLY SCORE"
                                   FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.EarnedCount, Mode=OneWay}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="BADGES EARNED"
                                   FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
                            <TextBlock Text="{x:Bind ViewModel.CollectionPercent, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="%"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Bottom" Margin="1,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="COLLECTION"
                                   FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Progress bar -->
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="Badge progress"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.EarnedCount, Mode=OneWay}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text=" / " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalBadgeCount, Mode=OneWay}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{x:Bind ViewModel.CollectionPercent, Mode=OneWay}"
                             Maximum="100"
                             Height="10"
                             Foreground="{StaticResource GoldBrush}"
                             Background="{StaticResource CardHoverBrush}"/>
            </StackPanel>

            <!-- Section heading -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1.5"
                    Padding="0,0,0,10">
                <TextBlock Text="Badge Collection"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- Badge grid -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AllBadgeCards, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="148"
                                       MinItemHeight="118"
                                       MinRowSpacing="10"
                                       MinColumnSpacing="10"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BadgeCardViewModel">
                        <Border CornerRadius="10" Padding="14"
                                Background="{x:Bind CardBackground}"
                                BorderBrush="{x:Bind CardBorderBrush}"
                                BorderThickness="1.5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind StarIcon}"
                                           FontSize="22"
                                           Foreground="{x:Bind StarForeground}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{x:Bind Badge.Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#F5F0E8"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{x:Bind Badge.Description}"
                                           FontSize="11"
                                           Foreground="#8A8074"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{x:Bind EarnedLabel}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{x:Bind StarForeground}"
                                           CharacterSpacing="80"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
