<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.PriceWatcher.Views.PriceWatcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="Price Watchers"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Track ticket prices and get notified when they drop below your target."
                           FontSize="14" Opacity="0.6" />
            </StackPanel>

            <!-- Feedback messages -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="#FFD13438" FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                           Foreground="#FF4CAF50" FontSize="13" />
            </StackPanel>

            <!-- Add new watcher -->
            <Border CornerRadius="8" Padding="16" Background="{StaticResource CardBackgroundBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add a watcher"
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Movie / Event" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="Target Price" FontSize="12" Opacity="0.7" />

                        <AutoSuggestBox Grid.Row="1" Grid.Column="0"
                                        x:Name="MovieSearchBox"
                                        PlaceholderText="Search by title..."
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                        ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                        DisplayMemberPath="Title"
                                        TextMemberPath="Title"
                                        TextChanged="MovieSearchBox_TextChanged"
                                        SuggestionChosen="MovieSearchBox_SuggestionChosen" />
                        <NumberBox Grid.Row="1" Grid.Column="1"
                                   Value="{x:Bind ViewModel.NewTargetPrice, Mode=TwoWay}"
                                   Minimum="0"
                                   SpinButtonPlacementMode="Compact" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="Add"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.AddWatchCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Loading indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="32" Height="32"
                          HorizontalAlignment="Center" />

            <!-- Watcher list -->
            <StackPanel Spacing="8">
                <TextBlock Text="Current watchers"
                           FontSize="16" FontWeight="SemiBold" />

                <ListView ItemsSource="{x:Bind ViewModel.Watchers, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PriceWatcher">
                            <Border Margin="0,4" Padding="12,10" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE787;" FontSize="20"
                                              VerticalAlignment="Center" Opacity="0.7" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind EventTitle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="Event #" />
                                            <Run Text="{x:Bind EventId}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Spacing="1">
                                        <TextBlock Text="Target" FontSize="10" Opacity="0.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind TargetPrice}"
                                                   FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Content="Remove"
                                            Tag="{x:Bind EventId}"
                                            Click="RemoveButton_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
