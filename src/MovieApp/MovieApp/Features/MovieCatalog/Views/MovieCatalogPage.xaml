<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.MovieCatalog.Views.MovieCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:marketplace="using:MovieApp.Features.Marketplace.Views"
    xmlns:local="using:MovieApp.Features.MovieCatalog.Views"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <marketplace:FlashSaleBanner Grid.Row="0" ViewModel="{x:Bind FlashSaleVM, Mode=OneWay}"/>

        <!-- Horizontal filter bar -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="8" Margin="12,8,12,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search title..."
                         Width="180"/>

                <ComboBox x:Name="GenreFilter"
                          PlaceholderText="All genres"
                          Width="150"/>

                <NumberBox x:Name="MinRatingBox"
                           PlaceholderText="Min rating"
                           Width="130"
                           Minimum="0" Maximum="5"
                           SpinButtonPlacementMode="Hidden"/>

                <ComboBox x:Name="SortCombo" Width="190">
                    <ComboBoxItem Content="Price: Low → High" IsSelected="True"/>
                    <ComboBoxItem Content="Price: High → Low"/>
                    <ComboBoxItem Content="Rating: High → Low"/>
                    <ComboBoxItem Content="Rating: Low → High"/>
                </ComboBox>

                <Button Content="Filter"
                        Click="FilterButton_Click"
                        Background="{StaticResource GoldBrush}"
                        Foreground="#000000"
                        FontWeight="SemiBold"
                        Padding="18,8"/>
            </StackPanel>
        </Border>

        <!-- Movie grid -->
        <Grid Grid.Row="2" Padding="12,8,12,12">
            <TextBlock x:Name="FlashSaleEndedText"
                       Text="The flash sale has ended!"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <GridView x:Name="MoviesGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="MoviesGrid_ItemClick"
                      Padding="0">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:MovieCatalogItem">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="0" Width="200"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5"
                                PointerEntered="MovieCard_PointerEntered"
                                PointerExited="MovieCard_PointerExited">
                            <StackPanel Spacing="0" Padding="0,0,0,10">

                                <!-- Poster -->
                                <Grid Height="260">
                                    <Border Background="{StaticResource CardHoverBrush}" CornerRadius="10,10,0,0">
                                        <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Background="{StaticResource GoldBrush}" CornerRadius="12" Padding="8,4"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="10,10,0,0"
                                            Visibility="{x:Bind SaleVisibility, Mode=OneWay}">
                                        <TextBlock Text="SALE" FontSize="12" FontWeight="Bold" Foreground="#000000"/>
                                    </Border>
                                </Grid>

                                <!-- Genre · Year -->
                                <TextBlock Text="{x:Bind GenreYearTag}"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontSize="11" Margin="10,8,10,0"
                                           Opacity="0.9"/>

                                <!-- Title -->
                                <TextBlock Text="{x:Bind Title}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxLines="2"
                                           TextWrapping="Wrap" Margin="10,4,10,0"/>

                                <!-- Rating -->
                                <TextBlock Text="{x:Bind RatingAndReviewCountText, Mode=OneWay}"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Margin="10,4,10,0"/>

                                <!-- Price -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,4,10,0">
                                    <TextBlock Text="{x:Bind OriginalPriceText, Mode=OneWay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" TextDecorations="Strikethrough"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind SaleVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind CurrentPriceText, Mode=OneWay}"
                                               Foreground="{x:Bind PriceColor, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- View button -->
                                <Button Content="View"
                                        HorizontalAlignment="Stretch"
                                        Margin="10,8,10,0"
                                        Background="{StaticResource GoldBrush}"
                                        Foreground="#000000"
                                        FontWeight="SemiBold"
                                        Click="ViewButton_Click"
                                        Tag="{x:Bind Id}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
