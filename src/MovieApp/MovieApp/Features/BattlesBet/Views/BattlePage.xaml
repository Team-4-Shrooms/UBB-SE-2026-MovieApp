<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.BattlesBet.Views.BattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MovieApp.Features.Shared.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityInverterConverter x:Key="BoolToVisibilityInverter"/>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBool"/>
    </Page.Resources>

    <Grid Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <TextBlock Text="Battle Arena"
                           FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock FontSize="14" Margin="0,0,0,20"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Your Points: "/>
                    <Run Text="{Binding TotalPoints, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="Demo:" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13"/>

                        <Button Content="End Battle Now"
                                Command="{Binding ForceSettleCommand}"
                                IsEnabled="{Binding IsBattleActive, Mode=OneWay}"
                                ToolTipService.ToolTip="Immediately settle the active battle and distribute points"/>

                        <Button Content="Reset Demo"
                                Command="{Binding ResetDemoCommand}"
                                ToolTipService.ToolTip="Delete all battles, refund frozen points, and create a new active battle"/>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding HasBattle, Converter={StaticResource BoolToVisibilityInverter}, FallbackValue=Visible}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="40" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text=" " FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="No active battle this week"
                                   FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Check back Monday for the next matchup! Or press Reset Demo above."
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding HasBattle, Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <Border CornerRadius="8" Width="120" Height="180" Margin="0,0,0,12">
                                <Image Source="{Binding ActiveBattle.FirstMovie.PosterUrl, Mode=OneWay}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveBattle.FirstMovie.Title, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="⭐" FontSize="16"/>
                                <TextBlock Text="{Binding ActiveBattle.FirstMovie.Rating, Mode=OneWay}"
                                           FontSize="20" FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="VS"
                               FontSize="28" FontWeight="ExtraBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <Border CornerRadius="8" Width="120" Height="180" Margin="0,0,0,12">
                                <Image Source="{Binding ActiveBattle.SecondMovie.PosterUrl, Mode=OneWay}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveBattle.SecondMovie.Title, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="⭐" FontSize="16"/>
                                <TextBlock Text="{Binding ActiveBattle.SecondMovie.Rating, Mode=OneWay}"
                                           FontSize="20" FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Visibility="{Binding IsBattleFinished, Converter={StaticResource BoolToVisibility}}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="🏆 BATTLE RESULT"
                                   FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="150"
                                   Foreground="White" Opacity="0.8"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Winner:" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WinnerMovieName, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Winning bettors received 2× their points!"
                                   FontSize="12" Foreground="White" Opacity="0.8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="BattleStatusBar"
                         Message="{Binding StatusMessage, Mode=OneWay}"
                         IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBool}}"
                         Severity="Informational"
                         Margin="0,0,0,12"/>

                <StackPanel Visibility="{Binding HasBattle, Converter={StaticResource BoolToVisibility}}">

                    <Border Visibility="{Binding IsBattleFinished, Converter={StaticResource BoolToVisibility}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            HorizontalAlignment="Center">
                        <TextBlock Text="⏰ This battle has ended — press Reset Demo to start a new one."
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <TextBlock Visibility="{Binding HasBet, Converter={StaticResource BoolToVisibility}}"
                               Text="✅ You've already placed a bet — only one bet is allowed per battle."
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <Button Content="🎲 Bet Now"
                            Command="{Binding ShowBetFormCommand}"
                            Visibility="{Binding CanBet, Converter={StaticResource BoolToVisibility}}"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            FontSize="16"/>

                    <Border Visibility="{Binding ShowBetForm, Converter={StaticResource BoolToVisibility}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Place Your Bet" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Select Movie:" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding BetMovieOptions}"
                                      SelectedItem="{Binding SelectedBetMovie, Mode=TwoWay}"
                                      DisplayMemberPath="Title"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="Points to Bet:" Margin="0,0,0,4"/>
                            <NumberBox Value="{Binding BetAmount, Mode=TwoWay}"
                                       Minimum="1" SpinButtonPlacementMode="Compact"
                                       Margin="0,0,0,12"/>

                            <Button Content="Confirm Bet"
                                    Command="{Binding PlaceBetCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding HasBet, Converter={StaticResource BoolToVisibility}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Your Active Bet" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0">
                                <Run Text="Movie: "/>
                                <Run Text="{Binding UserBet.Movie.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Amount: "/>
                                <Run Text="{Binding UserBet.Amount, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" points"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
