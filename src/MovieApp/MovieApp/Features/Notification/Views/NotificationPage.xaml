<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Notification.Views.NotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <!-- Header: title + unread badge + Mark All Read -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="Notifications"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <Border Background="#C8971A"
                            CornerRadius="12"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.UnreadCount, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#0B0B1E"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Mark All Read"
                        Command="{x:Bind ViewModel.MarkAllReadCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Notifications list -->
            <ListView ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Notification">
                        <Border Background="#252525"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Type}"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                    <TextBlock Text="{x:Bind Message}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind EventId}"
                                                   FontSize="11"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind CreatedAt}"
                                                   FontSize="11"
                                                   Opacity="0.6"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Mark Read"
                                        Click="MarkRead_Click"
                                        VerticalAlignment="Center"
                                        Padding="10,6"
                                        FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>

</Page>
