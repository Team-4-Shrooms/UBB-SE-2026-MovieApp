<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Leaderboard.Views.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieApp.Features.Leaderboard.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="Leaderboard"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Top users ranked by total points."
                           FontSize="14" Opacity="0.6" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">
                <ListView ItemsSource="{x:Bind ViewModel.Ranking, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="16,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="User"
                                           FontWeight="SemiBold"
                                           Opacity="0.7" />
                                <TextBlock Grid.Column="1"
                                           Text="Total points"
                                           FontWeight="SemiBold"
                                           Opacity="0.7"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="Weekly score"
                                           FontWeight="SemiBold"
                                           Opacity="0.7"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserStats">
                            <Grid Padding="16,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind User.Username, FallbackValue=''}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind TotalPoints}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind WeeklyScore}"
                                           FontSize="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
