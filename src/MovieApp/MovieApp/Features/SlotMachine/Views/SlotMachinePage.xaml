<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.SlotMachine.Views.SlotMachinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    xmlns:logicModels="using:MovieApp.Logic.Models"
    xmlns:converters="using:MovieApp.Features.Shared.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title -->
            <TextBlock Grid.Row="0"
                       Text="Slot Machine"
                       FontSize="28"
                       FontWeight="Bold"/>

            <!-- Row 1: Three-panel reel display -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    BorderBrush="#C8971A"
                    BorderThickness="2"
                    Padding="20,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Genre reel -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="GENRE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <Border Background="#16163A"
                                BorderBrush="#C8971A"
                                BorderThickness="0,2"
                                Height="72"
                                CornerRadius="4"
                                Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.SelectedGenre.Name, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Actor reel -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="ACTOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <Border Background="#16163A"
                                BorderBrush="#C8971A"
                                BorderThickness="0,2"
                                Height="72"
                                CornerRadius="4"
                                Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.SelectedActor.Name, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Director reel -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="DIRECTOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <Border Background="#16163A"
                                BorderBrush="#C8971A"
                                BorderThickness="0,2"
                                Height="72"
                                CornerRadius="4"
                                Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.SelectedDirector.Name, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Stats + Spin button -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0E0E24"
                        BorderBrush="#C8971A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="DAILY SPINS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.AvailableSpins, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#0E0E24"
                        BorderBrush="#3A3A6A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="BONUS SPINS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.BonusSpins, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#0E0E24"
                        BorderBrush="#3A3A6A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        Margin="0,0,16,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="STREAK"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.LoginStreak, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="3"
                        Content="SPIN"
                        Command="{x:Bind ViewModel.SpinCommand}"
                        Width="180"
                        Padding="0,16"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#C8971A"
                        Foreground="#0B0B1E"
                        CornerRadius="10"/>
            </Grid>

            <!-- Row 3: Progress ring -->
            <ProgressRing Grid.Row="3"
                          IsActive="{x:Bind ViewModel.IsSpinning, Mode=OneWay}"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"/>

            <!-- Row 4: Jackpot panel -->
            <Border Grid.Row="4"
                    Background="#40C8971A"
                    BorderBrush="#C8971A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Visibility="{x:Bind ViewModel.IsJackpot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="JACKPOT!"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#C8971A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.JackpotMovieTitle, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.JackpotDiscountPercentage, Mode=OneWay}"
                                   FontSize="14"/>
                        <TextBlock Text="% discount earned"
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 5: Matching events -->
            <StackPanel Grid.Row="5" Spacing="8">
                <TextBlock Text="Matching Events"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.MatchingEvents, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Event">
                            <StackPanel Spacing="4" Padding="0,6">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind EventDateTime}"
                                           FontSize="12"
                                           Opacity="0.7"/>
                                <TextBlock Text="{x:Bind TicketPrice}"
                                           FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Row 6: Spin history -->
            <StackPanel Grid.Row="6" Spacing="8">
                <TextBlock Text="Spin History"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="logicModels:SlotMachineResult">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Genre.Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Actor.Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Director.Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind JackpotMovie.Title}"
                                           FontWeight="Bold"
                                           Foreground="#C8971A"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>
