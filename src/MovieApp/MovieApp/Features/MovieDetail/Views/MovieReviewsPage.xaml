<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.MovieDetail.Views.MovieReviewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content=""
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Click="BackButton_Click"
                    Background="Transparent"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="TitleBlock"
                       Grid.Column="1"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
            <Button x:Name="AddReviewButton"
                    Grid.Column="2"
                    Content="Add review"
                    Click="AddReviewButton_Click"
                    CornerRadius="8"
                    Padding="14,10"
                    Background="{StaticResource GoldBrush}"
                    Foreground="#000000"/>
        </Grid>

        <ListView x:Name="ReviewsList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:MovieReview">
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind User.Username}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind StarRating}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold"/>
                                <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind DisplayCreatedAt}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Comment}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
