<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MovieApp.Features.Marketplace.Views.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MovieApp.DataLayer.Models"
    xmlns:viewmodels="using:MovieApp.Features.Marketplace.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
            <TextBlock Text="Available Equipment" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Button Content="+ Sell Your Gear" Click="GoToSell_Click"
                    Background="{StaticResource GoldBrush}" Foreground="#000000" CornerRadius="4" Margin="20,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Filter by:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox x:Name="CategoryFilter" Width="200" SelectionChanged="CategoryFilter_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Cameras"/>
                <ComboBoxItem Content="Microphones"/>
                <ComboBoxItem Content="Lighting"/>
                <ComboBoxItem Content="Accessories"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableItems, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Equipment">
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Margin="10" Width="260" Height="400"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="0">
                                <Border CornerRadius="12,12,0,0" Height="180" Background="{StaticResource CardHoverBrush}" IsHitTestVisible="False">
                                    <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Source>
                                            <Binding Path="ImageUrl" Mode="OneWay">
                                                <Binding.FallbackValue>
                                                    <BitmapImage UriSource="ms-appx:///Assets/StoreLogo.png"/>
                                                </Binding.FallbackValue>
                                            </Binding>
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <StackPanel Padding="15" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                               MaxLines="2" Height="45" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>

                                    <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <TextBlock Text="{x:Bind Price}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>

                                    <Button Content="VIEW DETAILS" Click="ViewDetails_Click"
                                            HorizontalAlignment="Stretch" Background="{StaticResource GoldBrush}" Foreground="#000000"
                                            CornerRadius="6" Margin="0,10,0,0" Height="35"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
