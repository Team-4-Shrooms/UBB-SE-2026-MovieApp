<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MovieApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MovieApp">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged"
        OpenPaneLength="260">

        <NavigationView.MenuItems>

            <!-- Catalog — top-level, mirrors web navbar -->
            <NavigationViewItem Content="Catalog" Tag="MovieCatalog" Icon="Library"/>

            <!-- Discover: Marketplace + Trailer Scraping -->
            <NavigationViewItem Content="Discover" Icon="Globe" IsExpanded="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Marketplace"      Tag="Marketplace"    Icon="Shop"/>
                    <NavigationViewItem Content="Trailer Scraping" Tag="TrailerScraping" Icon="Find"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <!-- Events: Events, Screenings, Marathon -->
            <NavigationViewItem Content="Events" Icon="Calendar" IsExpanded="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Events"    Tag="Events"    Icon="Calendar"/>
                    <NavigationViewItem Content="Screenings" Tag="Screenings" Icon="VideoChat"/>
                    <NavigationViewItem Content="My Bookings" Tag="MyBookings" Icon="Pin"/>
                    <NavigationViewItem Content="Marathon"  Tag="Marathon"  Icon="Go"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <!-- Compete: Tournament, Battles, Trivia, Slots, Swipe, Personality Match -->
            <NavigationViewItem Content="Compete" Icon="Target" IsExpanded="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Tournament"        Tag="MovieTournament"  Icon="FourBars"/>
                    <NavigationViewItem Content="Battle &amp; Bet"  Tag="BattlesBet"       Icon="Target"/>
                    <NavigationViewItem Content="Trivia"            Tag="TriviaWheel"      Icon="Help"/>
                    <NavigationViewItem Content="Slot Machine"      Tag="SlotMachine"      Icon="RepeatAll"/>
                    <NavigationViewItem Content="Movie Swipe"       Tag="MovieSwipe"       Icon="Shuffle"/>
                    <NavigationViewItem Content="Personality Match" Tag="PersonalityMatch" Icon="Contact"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <!-- Reels: Feed, Upload, Editing -->
            <NavigationViewItem Content="Reels" Icon="Video" IsExpanded="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Feed"    Tag="ReelsFeed"     Icon="Video"/>
                    <NavigationViewItem Content="Upload"  Tag="ReelsUpload"   Icon="Upload"/>
                    <NavigationViewItem Content="Editing" Tag="ReelsEditing"  Icon="Edit"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <!-- Account: Profile, Inventory, Wallet, Referrals, Ambassadors, Price Watchers, Leaderboard -->
            <NavigationViewItem Content="Account" Icon="Contact" IsExpanded="False">
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Profile"         Tag="Badges"       Icon="ContactInfo"/>
                    <NavigationViewItem Content="Inventory"       Tag="Inventory"    Icon="AllApps"/>
                    <NavigationViewItem Content="Wallet"          Tag="Wallet"       Icon="Account"/>
                    <NavigationViewItem Content="Referrals"       Tag="Referrals"    Icon="ContactInfo"/>
                    <NavigationViewItem Content="Ambassadors"     Tag="Ambassadors"  Icon="OtherUser"/>
                    <NavigationViewItem Content="Price Watchers"  Tag="PriceWatcher" Icon="Flag"/>
                    <NavigationViewItem Content="Leaderboard"     Tag="Leaderboard"  Icon="List"/>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Notifications" Tag="Notification" Icon="Mail">
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{x:Bind NotificationViewModel.UnreadCount, Mode=OneWay}"
                               Visibility="{x:Bind NotificationViewModel.BadgeVisibility, Mode=OneWay}"/>
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

</Window>
